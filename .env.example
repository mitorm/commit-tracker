# Copy this file to `.env` and fill in your values. `.env` is gitignored.
# No GitHub token is needed -- everything is read from your local clone.

# Absolute path to your local clone of the monorepo.
REPO_PATH=/Users/you/path/to/monorepo

# Your git author email(s), comma-separated. A commit counts as "yours" when
# its git author matches one of these.
MY_EMAILS=you@example.com
